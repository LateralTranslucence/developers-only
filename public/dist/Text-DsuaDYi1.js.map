@use '../abstracts' as *;

// Two-column text panel: heading beside copy, CTA under the copy. Collapses to
// a single column on narrow screens.
section.panel-type-text {
    div.container {
        display: grid;
        grid-template-columns: 47.5% 45.7%;
        grid-template-rows: auto 1fr;
        grid-template-areas:
            "header copy"
            "header cta";
        column-gap: 5%;

        header {
            grid-area: header;
        }
        div.panel-copy-wrapper {
            grid-area: copy;
        }
        p.panel-cta {
            grid-area: cta;

            @include max-1024 {
                flex-direction: column;
            }
        }

        @include max-768 {
            display: flex;
            flex-direction: column;
        }
    }
}
