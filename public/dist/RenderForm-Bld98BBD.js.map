@use '../abstracts' as *;

// Disabled Things
input.disabled, button.disabled {
    cursor: default;
}
/* Honeypot wrapper. Moved out of view rather than display:none - some bots skip
   fields they can tell are hidden, and the point is that they fill this one in.
   aria-hidden and tabindex="-1" on the markup keep it away from everyone else. */
div.form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
}

/* Server-side notice shown above the form (rate limiting, etc.). Structural
   only - the theming layer supplies colour. */
p.form__notice {
    margin-bottom: 1rem;
}
