@use '../abstracts' as *;

ul.accordion {
    margin: 0;
    padding: 0;
    list-style: none;
}

h3.accordion__header {
    margin: 0;
}

button.accordion__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    width: 100%;
    padding: 1em 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;

    &:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 2px;
    }

    &[aria-expanded="true"] span.accordion__icon::before {
        transform: rotate(180deg);
    }
}

span.accordion__trigger-text {
    font-size: 1.25em;

    @include max-768 {
        font-size: 1em;
    }
}

span.accordion__icon {
    flex-shrink: 0;

    &::before {
        content: '\f078'; // chevron-down
        @include font(icon);
        display: inline-block;
        transition: transform 0.2s ease;
    }
}

div.accordion__panel {
    padding: 0 0 1.5em;

    &[hidden] {
        display: none;
    }
}
