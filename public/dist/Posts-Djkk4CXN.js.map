@use '../abstracts' as *;

div.panel-slider-wrapper {
    position: relative;
}
// Arrows
a.btn-next, a.btn-previous {
    &::after {
        @include font(icon);
        display: inline-block;
        width: 1.5em;
        height: 1.5em;
        text-align: center;
    }
}
a.btn-next::after {
    content: '\f054';
}
a.btn-previous::after {
    content: '\f053';
}

// Buttons
a.slider-buttons {
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9999;
    &::after {
        font-size: 1.25em;
        line-height: 2.4em;
        width: 2.4em;
        height: 2.4em;
        text-align: center;
    }
    &:focus {
        color: inherit;
    }
    &.btn-previous {
        left: 0;
    }
    &.btn-next {
        right: 0px;
    }
}
