ul.blocks.list{-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center}ul.blocks.list>li{width:100%}@media(max-width: 900px){ul.blocks.list>li{width:100%}ul.blocks.list>li>li,ul.blocks.list>li>li.open{width:100%}}ul.blocks.list>li div.block-content-wrapper{padding:2em 2em 2em 3.5em}ul.blocks.list>li h3{font-family:neue-haas-grotesk-display,sans-serif;font-weight:500;font-size:1.5em;line-height:1.257em;margin-bottom:0}ul.blocks.list>li.glossary h3{margin-bottom:.5em}ul.blocks.list>li.glossary div.glossary-term-full{display:none;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column}ul.blocks.list>li.glossary div.glossary-term-full>h4{font-size:1em;border-bottom:1px solid #9c98dd;margin-top:3em;padding-bottom:.25em}ul.blocks.list>li.glossary div.glossary-term-full div.panel-slider-wrapper a.slider-buttons{font-size:.75em}@media(max-width: 900px){ul.blocks.list>li.glossary div.glossary-term-full div.panel-slider-wrapper a.slider-buttons{font-size:.5em}}ul.blocks.list>li.glossary div.glossary-term-overview>p,ul.blocks.list>li.glossary div.glossary-term-full>p{font-size:1em}ul.blocks.list>li.glossary button.glossary-term-open,ul.blocks.list>li.glossary button.glossary-term-close{background:rgba(0,0,0,0);border:none;font-size:1em;position:absolute;left:1.85em;cursor:pointer}ul.blocks.list>li.glossary button.glossary-term-open>span,ul.blocks.list>li.glossary button.glossary-term-close>span{display:none}ul.blocks.list>li.glossary button.glossary-term-open::before,ul.blocks.list>li.glossary button.glossary-term-close::before{font-family:"FontAwesomeSolid";display:block;position:absolute;top:0;left:0;width:1.75em;height:1.75em;border-radius:100px;font-size:1em;line-height:1.75em;text-align:center}ul.blocks.list>li.glossary button.glossary-term-open:focus,ul.blocks.list>li.glossary button.glossary-term-close:focus{outline:none}ul.blocks.list>li.glossary button.glossary-term-open:focus::before,ul.blocks.list>li.glossary button.glossary-term-close:focus::before{outline:2px #17d7ca dashed}ul.blocks.list>li.glossary button.glossary-term-open{top:3em}ul.blocks.list>li.glossary button.glossary-term-open::before{content:"+";background-color:#2c25ab;color:#fff}ul.blocks.list>li.glossary button.glossary-term-close{display:none;top:3em}ul.blocks.list>li.glossary button.glossary-term-close::before{content:"";background-color:#fff;color:#2c25ab;border:1px #2c25ab solid}ul.blocks.list>li.glossary ul.glossary-term-related-resources{width:100%;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li{list-style:none;padding:0;margin:0;width:50%}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li:nth-child(2){padding-left:1em}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link{display:grid;grid-template-rows:[one] auto [end];grid-template-columns:[one] auto [two] 1fr [end];grid-column-gap:1em;-webkit-column-gap:1em;-moz-column-gap:1em;column-gap:1em}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link span.do-image-wrapper{grid-row:one/end;grid-column:one/two;width:200px !important;border-radius:10px 10px 0 10px}@media(max-width: 1024px){ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link span.do-image-wrapper{width:150px !important}}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link span.do-image-wrapper figure.do-image{border-radius:10px 10px 0 10px}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link h5{font-size:1em;margin-top:0;grid-row:one/end;grid-column:two/end}@media(max-width: 900px){ul.blocks.list>li.glossary ul.glossary-term-related-resources{display:block}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li{width:100%;margin-bottom:1em}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li:nth-child(2){padding-left:0}}@media(max-width: 520px){ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link{display:grid;grid-template-rows:[one] auto [two] auto [end];grid-template-columns:[one] auto [end];grid-row-gap:.5em;row-gap:.5em}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link span.do-image-wrapper{grid-row:one/two;grid-column:one/end}ul.blocks.list>li.glossary ul.glossary-term-related-resources>li a.block-link h5{grid-row:two/end;grid-column:one/end}}ul.blocks.list>li.glossary.open::after{content:"";display:inline-block;width:calc(100% - 2.65em);height:4px;background:-webkit-gradient(linear, left top, right top, from(#0D0B33), color-stop(30%, #2C25AB), to(#17D7CA)) 0 100%;background:linear-gradient(90deg, #0D0B33, #2C25AB 30%, #17D7CA) 0 100%;position:absolute;bottom:1em;right:1em;border-radius:0 0 0 23px}ul.blocks.list>li.glossary.open div.glossary-term-overview{display:none}ul.blocks.list>li.glossary.open div.glossary-term-full{display:-webkit-box;display:-ms-flexbox;display:flex}ul.blocks.list>li.glossary.open button.glossary-term-open{display:none}ul.blocks.list>li.glossary.open button.glossary-term-close{display:inline}
