div.background-video-wrapper.has-avatar{opacity:.85;width:1080px;height:100%;display:inline-block;position:absolute;top:0;right:calc(50% - 830px);overflow:hidden;z-index:0}div.background-video-wrapper.has-avatar video{min-width:100%;min-height:100%;z-index:-1;position:absolute;top:50%;left:50%;-webkit-transform:translate(-50%, -50%);transform:translate(-50%, -50%);-o-object-fit:cover;object-fit:cover}div.do-controls-wrapper{font-size:1em;position:absolute;bottom:0;left:0;padding:0 2.5px;background:rgba(13,11,50,.2);z-index:9}div.do-controls-wrapper button.do-control{display:inline-block;margin:2.5px;border:0;background:rgba(0,0,0,0);cursor:pointer}div.do-controls-wrapper button.do-control::after{display:block;width:1.75em;height:1.75em;padding:.25em;font-family:"FontAwesomeSolid";color:#fff;line-height:1.25em}div.do-controls-wrapper button.do-control.play::after{content:""}div.do-controls-wrapper button.do-control.pause::after{content:""}div.do-controls-wrapper button.do-control.forward::after{content:""}div.do-controls-wrapper button.do-control.rewind::after{content:""}div.do-controls-wrapper button.do-control>span{display:none}header.has-video-controls>div.do-controls-wrapper{display:inline-block}
ul#breadcrumbs{font-size:.75em;margin:0;display:-webkit-box;display:-ms-flexbox;display:flex}ul#breadcrumbs>li{margin:0 .5em 0 0;padding:0;list-style:none}ul#breadcrumbs>li a{color:#0d0b33;line-height:1em}ul#breadcrumbs>li:not(:last-child)::after{content:"";font-family:"FontAwesomeSolid";color:#ffb400;margin-left:.25em;line-height:1em}main.iframe ul#breadcrumbs>li a{color:#0d0b33 !important}@media print{ul#breadcrumbs{display:none}}.color-blue ul#breadcrumbs>li a{color:#fff}.color-navy ul#breadcrumbs>li a{color:#fff}.color-teal ul#breadcrumbs>li a{color:#0d0b33}.color-teal ul#breadcrumbs>li:not(:last-child)::after{color:#fff}.color-white ul#breadcrumbs>li a{color:#0d0b33}.color-yellow ul#breadcrumbs>li a{color:#0d0b33}.color-yellow ul#breadcrumbs>li:not(:last-child)::after{color:#fff}
figure.do-video{max-width:100%;overflow:hidden}figure.do-video span.do-video-wrapper{width:100%;height:0;padding-top:56.25%;overflow:hidden;position:relative;border-radius:23px 23px 0px 23px;display:block;width:100%;height:0;padding-top:56.25%;overflow:hidden;position:relative;border-radius:23px 23px 0px 23px}figure.do-video span.do-video-wrapper>iframe,figure.do-video span.do-video-wrapper>div.video-player{width:100%;height:100%;position:absolute;top:0;left:0}figure.do-video span.do-video-wrapper>iframe>iframe,figure.do-video span.do-video-wrapper>div.video-player>iframe{width:100%;height:100%}figure.do-video.embed span.do-video-wrapper{padding-top:100%}figure.do-video.embed span.do-video-wrapper video{position:absolute;top:0;left:0;width:100%}header figure.do-video,div.panel-copy-wrapper figure.do-video{margin:0 auto}ul.panel-videos.blocks.one li{width:100%;padding:0;-webkit-box-align:center;-ms-flex-align:center;align-items:center}ul.panel-videos.blocks.one li figure.do-video{width:600px}ul.panel-videos.blocks.one li>p{width:100%;max-width:600px}ul.panel-videos.blocks.one li.has-copy{-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row;-webkit-box-align:start;-ms-flex-align:start;align-items:flex-start}ul.panel-videos.blocks.one li.has-copy div.video-copy-wrapper{width:50%;margin-left:5%}ul.panel-videos.blocks.one li.has-copy div.video-copy-wrapper h3{margin-bottom:1.75em}@media(max-width: 900px){ul.panel-videos.blocks.one li.has-copy{-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-box-align:center;-ms-flex-align:center;align-items:center}ul.panel-videos.blocks.one li.has-copy div.video-copy-wrapper{width:100%;max-width:600px;margin:2em 0 0 0}}img.video-fallback-image{width:100%}div.do-video-player-wrapper{width:100%;height:100%;position:absolute;top:0;left:0}div.do-video-player-wrapper>iframe{width:100%;height:100%}
ul.do-share-bar{margin:0;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row;position:relative}ul.do-share-bar::before{content:attr(data-label);font-size:.875em;font-family:neue-haas-grotesk-display,sans-serif;font-weight:700}ul.do-share-bar li{margin:0;padding:0;list-style:none}ul.do-share-bar li>a:not(.button){margin-left:15px;font-size:1.25em;color:#ffb400}ul.do-share-bar li>a:not(.button):hover{opacity:.5}ul.do-share-bar li>a:not(.button)>span{display:none}ul.do-share-bar li>a:not(.button).fa-envelope::before{font-family:"FontAwesomeSolid"}ul.do-share-bar li.do-share-newsletter-signup{width:200px;position:absolute;right:0;top:50%;-webkit-transform:translateY(-50%);transform:translateY(-50%)}ul.do-share-bar li.do-share-newsletter-signup>a{text-align:left}ul.do-share-bar li.do-share-newsletter-signup>a>span{display:inline}@media(max-width: 768px){ul.do-share-bar li.do-share-newsletter-signup{width:165px}}@media(max-width: 480px){ul.do-share-bar{padding-bottom:40px}ul.do-share-bar li.do-share-newsletter-signup{width:100%;top:auto;bottom:20px;left:0;margin:0}ul.do-share-bar li.do-share-newsletter-signup>a{margin-left:0}}@media print{ul.do-share-bar{display:none}}
header#hero{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;padding:50px 0;position:relative;z-index:99;overflow:hidden}header#hero.has-background{min-height:250px}@media(max-width: 600px){header#hero.has-background{min-height:none}}@media(max-width: 768px){header#hero.has-background{position:relative}}header#hero:not(.has-background):not(.has-featured){padding-bottom:0}header#hero div.hero-container{height:100%;position:relative;display:grid;grid-template-columns:[one] 47.5% [two] 47.5% [end];grid-template-rows:[one] auto [two] auto [three] 1fr [end];grid-column-gap:5%;-webkit-column-gap:5%;-moz-column-gap:5%;column-gap:5%;grid-row-gap:2em;row-gap:2em}header#hero div.hero-container p#breadcrumbs{grid-column:one/end;grid-row:one/two}header#hero div.hero-container div.hero-text-wrapper{width:100%;grid-column:one/two;grid-row:two/three;align-self:center;justify-self:center;place-self:center;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column}header#hero div.hero-container div.hero-text-wrapper p:not(#hero-cta){font-size:1.15em}header#hero div.hero-container div.hero-text-wrapper p#hero-cta{width:-webkit-fit-content;width:-moz-fit-content;width:fit-content;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-ms-flex-flow:wrap;flex-flow:wrap;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center}header#hero div.hero-container div.hero-media-wrapper{width:100%;grid-column:two/end;grid-row:two/three;align-self:center;justify-self:center;place-self:center}header#hero div.hero-container div.hero-media-wrapper span.do-image-wrapper{max-height:480px;width:100% !important}header#hero div.hero-container div.hero-media-wrapper figure.do-video{position:relative}header#hero div.hero-container div.hero-media-wrapper figure.do-video.embed{position:static;-webkit-transform:none;transform:none}header#hero div.hero-container div.hero-media-wrapper figure.do-video.embed span.do-video-wrapper{padding-top:95%;width:95%}header#hero.has-form div.hero-container div.hero-text-wrapper{-ms-flex-item-align:start;align-self:start;margin-top:100px}header#hero.has-avatar{background-position:45vw 50%;background-size:auto;background-repeat:no-repeat}@media(min-width: 1281px){header#hero.has-avatar{background-position-x:calc(50% + 540px)}}header#hero.color-teal.has-avatar{background-position-y:45%}@media(max-width: 900px){header#hero.has-media{padding-bottom:0}header#hero div.hero-container{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-column-gap:2em;-moz-column-gap:2em;column-gap:2em}header#hero div.hero-container div.hero-text-wrapper{width:100%}header#hero div.hero-container div.hero-text-wrapper p#hero-cta>.do-cta{margin-top:.5em}header#hero div.hero-container div.hero-media-wrapper{width:calc(100% + 80px);margin-top:2em}header#hero div.hero-container div.hero-media-wrapper span.do-image-wrapper,header#hero div.hero-container div.hero-media-wrapper figure.do-image{border-radius:0}}main.iframe header#hero{background:none !important;padding-bottom:0;min-height:0}main.iframe header#hero.color-blue,main.iframe header#hero.color-navy,main.iframe header#hero.color-teal,main.iframe header#hero.color-white,main.iframe header#hero.color-yellow{color:#0d0b33}main.iframe header#hero.color-blue.has-avatar,main.iframe header#hero.color-navy.has-avatar,main.iframe header#hero.color-teal.has-avatar,main.iframe header#hero.color-white.has-avatar,main.iframe header#hero.color-yellow.has-avatar{background:none}main.home header#hero.has-background{min-height:700px}@media(max-width: 600px){main.home header#hero.has-background{min-height:none}}
