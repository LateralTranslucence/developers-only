button#do-to-top{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-align:center;-ms-flex-align:center;align-items:center;font-size:1em;width:40px;height:40px;padding:.5em .5em .5em .75em;position:fixed;bottom:4em;right:0;color:#fff;background:#2c25ab;border:1px #0d0b33 solid;border-right:none;border-radius:4px 0 0 4px;z-index:99;opacity:0;-webkit-transition:width 1s;transition:width 1s}button#do-to-top.show{opacity:1}button#do-to-top::before{content:"";font-family:"FontAwesomeSolid";font-size:1.5em;color:#fff;margin-right:.5em;-webkit-transition:color .5s linear;transition:color .5s linear}button#do-to-top:hover{cursor:pointer;width:7em;right:0;-webkit-transition:width 1s;transition:width 1s;-webkit-text-decoration:none;text-decoration:none}button#do-to-top>span{white-space:nowrap}@media(max-width: 600px){button#do-to-top{width:30px;height:30px;padding:.5em}button#do-to-top::before{font-size:1em;margin-right:1em}}@media print{button#do-to-top{display:none}}
