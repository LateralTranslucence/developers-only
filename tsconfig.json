{
    "compilerOptions": {
        "baseUrl": "",
        "paths": {
            "*": ["*"]
        },
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react",
        "module": "ESNext",
        "moduleResolution": "node",
        "outDir": "./build/",
        "skipLibCheck": true,
        "strict": true,
        "target": "esnext",
        "typeRoots": ["./node_modules/@types", "./src/globals.d.ts"]
    },
    "exclude": ["node_modules"],
    "include": ["src/**/*"]
}